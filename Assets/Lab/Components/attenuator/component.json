  "data": {
    "id": "attenuator",
    "name": "Cryogenic attenuator",
    "category": "wiring",
    "parent": "wiring",
    "function": "Reduces the drive-line signal and, more importantly, the thermal noise arriving from warmer stages. An attenuator at temperature T_s replaces the incoming noise with its own thermal noise at T_s: a 20 dB attenuator passes 1 % of the incoming noise photons and adds 99 % of a T_s thermal population. The stage it sits on therefore matters as much as its value, and the dissipated drive power is a heat load on that stage.",
    "physics": {
      "summary": "Cascaded attenuators set the effective noise temperature at the qubit drive port.",
      "equations": [
        "attn_noise_cascade",
        "thermal_photon_number",
        "attn_dissipation"
      ]
    },
