      ]
    },
    "results": [
      {
        "label": "fidelity per cycle",
        "measured": "fit.p",
        "model": "prod(1 - device.calibration.edge[e].error_2q)",
        "tolerance": 0.3
      }
    ],
    "optional": true,
    "generator": {
      "kind": "xeb",
      "qubits": 2,
      "physical_qubits": [
        "$0",
